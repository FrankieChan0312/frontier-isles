# Non-secret local reference. Replace with the exact HTTPS origin before Human deployment UAT.
CLIENT_ORIGINS=http://127.0.0.1:3001
FRONTIER_PORT=3001
PERSISTENCE_PROVIDER=sqlite
# Optional future MySQL server configuration, never VITE_ variables:
# PERSISTENCE_PROVIDER=mysql
# MYSQL_HOST=mysql.example.invalid
# MYSQL_PORT=3306
# MYSQL_DATABASE=frontier_isles
# MYSQL_USER=replace_with_service_user
# MYSQL_PASSWORD=replace_with_secret_from_environment
# MYSQL_TLS=required
# MYSQL_TLS_CA_FILE=/private/path/to/ca-bundle.pem
# MYSQL_SCHEMA_MODE=verify
# Initialize only a dedicated empty schema with MYSQL_SCHEMA_MODE=initialize, then verify.
# These comments are not forwarded automatically by the SQLite Compose reference.
# Container defaults: NODE_ENV=production, PORT=3001, STATIC_ROOT=/app/public,
# PERSISTENCE_FILE=/data/frontier-isles.sqlite. Never mount /data inside /app/public.
# Direct Node operation requires all four production variables explicitly; see deployment runbook.
