{
  "name": "frontier-isles",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:contracts && vite",
    "dev:web": "npm run build:contracts && vite",
    "dev:server": "npm run build:contracts && npm run dev --workspace @frontier-isles/server",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --noEmit --pretty false",
    "typecheck:server": "npm run build:contracts && npm run typecheck --workspace @frontier-isles/realtime-contracts && npm run typecheck --workspace @frontier-isles/server",
    "lint": "eslint . --max-warnings 0",
    "lint:server": "eslint server packages/realtime-contracts --max-warnings 0",
    "test": "npm run build:contracts && vitest run",
    "test:server": "npm run build:contracts && npm run test --workspace @frontier-isles/realtime-contracts && npm run test --workspace @frontier-isles/server",
    "test:watch": "vitest",
    "build": "npm run build:contracts && tsc -b && vite build",
    "build:contracts": "npm run build --workspace @frontier-isles/realtime-contracts",
    "build:server": "npm run build:contracts && npm run build --workspace @frontier-isles/server",
    "preview": "vite preview",
    "simulate:core": "node --experimental-strip-types src/ai/simulation/run-core-simulations.ts",
    "simulate:mixed": "node --experimental-strip-types src/ai/simulation/run-mixed-simulations.ts",
    "simulate": "node --experimental-strip-types src/ai/simulation/run-release-simulations.ts",
    "e2e": "playwright test",
    "e2e:lobby": "playwright test tests/e2e/lobby.spec.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:server": "npm run typecheck:server && npm run lint:server && npm run test:server && npm run build:server",
    "check:all": "npm run check && npm run check:server"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@frontier-isles/realtime-contracts": "0.1.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
