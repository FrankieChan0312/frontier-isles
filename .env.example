PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
VITE_REALTIME_URL=http://127.0.0.1:3001
RECONNECT_GRACE_MS=30000
ROOM_IDLE_TTL_MS=1800000
GAME_ABANDONED_TTL_MS=1800000
RESTART_RECOVERY_GRACE_MS=120000
PERSISTENCE_FILE=data/frontier-isles.sqlite
PERSISTENCE_PROVIDER=sqlite
# Backend-only MySQL alternative (explicitly initialize an empty owned schema once).
# MYSQL_HOST=mysql.example.invalid
# MYSQL_PORT=3306
# MYSQL_DATABASE=frontier_isles
# MYSQL_USER=replace_with_service_user
# MYSQL_PASSWORD=replace_with_secret_from_environment
# MYSQL_TLS=required
# MYSQL_TLS_CA_FILE=/private/path/to/ca-bundle.pem
# MYSQL_SCHEMA_MODE=verify
