# Non-secret template. Copy outside Git to /etc/frontier-isles/mysql.env, mode 0600.
# Do not run `docker compose config` without --quiet against a real secret file.
FRONTIER_IMAGE=example.invalid/frontier-isles@sha256:REPLACE_WITH_QUALIFIED_DIGEST
CLIENT_ORIGINS=https://play.frankiesgroceryhk.shop
MYSQL_HOST=database.example.invalid
MYSQL_PORT=3306
MYSQL_DATABASE=frontier_isles
MYSQL_USER=frontier_runtime
MYSQL_PASSWORD=REPLACE_PRIVATELY
MYSQL_TLS_CA_HOST_FILE=/etc/frontier-isles/mysql-ca.pem
